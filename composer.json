{
    "name": "mateusjunges/laravel-trackable-jobs",
    "description": "This package allows you to track your jobs",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Mateus Junges",
            "email": "mateus@junges.dev",
            "role": "Software Engineer"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/support": "^12.0|^13.0",
        "illuminate/queue": "^12.0|^13.0",
        "illuminate/database": "^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpunit": "^9.5|^10.5|^11.5.3|^12.5.12",
        "spatie/test-time": "^1.2",
        "phpstan/phpstan": "^2.1",
        "laravel/pint": "^1.29"
    },
    "autoload": {
        "psr-4": {
            "Junges\\TrackableJobs\\": "src/",
            "Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Junges\\TrackableJobs\\Tests\\": "tests/"
        }
    },
    "prefer-stable": true,
    "extra": {
        "laravel": {
            "providers": [
                "Junges\\TrackableJobs\\Providers\\TrackableJobsServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit tests",
        "pint": "vendor/bin/pint",
        "pint:test": "vendor/bin/pint --test",
        "cs": [
            "@pint",
            "@phpstan"
        ],
        "phpstan": "vendor/bin/phpstan analyse"
    }
}
